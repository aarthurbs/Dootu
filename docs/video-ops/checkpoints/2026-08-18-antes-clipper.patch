@@ -1,24 +0,0 @@
--- ============================================================
--- 0002_sync.sql · Suporte à sincronização localStorage -> Postgres
--- Rode DEPOIS de 0001_init.sql.
--- ------------------------------------------------------------
---  - client_ref: guarda o id local (ex: 'p123...') para upsert idempotente.
---  - índice único (user_id, client_ref): alvo do ON CONFLICT (NULLs são
---    distintos no Postgres, então linhas sem client_ref não conflitam).
---  - default user_id = auth.uid(): o frontend não precisa enviar user_id;
---    a RLS (with check user_id = auth.uid()) continua valendo.
--- ============================================================
-
-alter table public.projects add column if not exists client_ref text;
-alter table public.products add column if not exists client_ref text;
-alter table public.prompts  add column if not exists client_ref text;
-
-create unique index if not exists projects_user_ref_uniq on public.projects(user_id, client_ref);
-create unique index if not exists products_user_ref_uniq on public.products(user_id, client_ref);
-create unique index if not exists prompts_user_ref_uniq  on public.prompts(user_id, client_ref);
-
-alter table public.projects        alter column user_id set default auth.uid();
-alter table public.prompts         alter column user_id set default auth.uid();
-alter table public.products        alter column user_id set default auth.uid();
-alter table public.amazon_accounts alter column user_id set default auth.uid();
-alter table public.publish_jobs    alter column user_id set default auth.uid();

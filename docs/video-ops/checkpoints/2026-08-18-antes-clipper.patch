--- ============================================================
--- 0001_init.sql · Fundação do banco (Fase 1)
--- Plataforma Seller Amazon FBA — Supabase / Postgres
--- ------------------------------------------------------------
--- Princípios:
---  - Tudo escopado por usuário (user_id = auth.uid()) com RLS ligada.
---  - SEGREDOS DA SP-API ficam em tabela isolada SEM policy de cliente:
---    só o service_role (Edge Functions) lê/escreve. Nunca no frontend.
---  - Espelha o estado atual do localStorage para migração suave.
--- ============================================================
-
-create extension if not exists pgcrypto;
-
--- ---------- util: updated_at automático ----------
-create or replace function public.set_updated_at()
-returns trigger language plpgsql as $$
-begin
-  new.updated_at = now();
-  return new;
-end;
-$$;
-
--- ============================================================
--- profiles — 1:1 com auth.users
--- ============================================================
-create table if not exists public.profiles (
-  id          uuid primary key references auth.users(id) on delete cascade,
-  email       text,
-  created_at  timestamptz not null default now()
-);
-alter table public.profiles enable row level security;
-
-create policy "profiles_select_own" on public.profiles
-  for select using (id = auth.uid());
-create policy "profiles_update_own" on public.profiles
-  for update using (id = auth.uid());
-
--- cria profile automaticamente no signup
-create or replace function public.handle_new_user()
-returns trigger language plpgsql security definer set search_path = public as $$
-begin
-  insert into public.profiles (id, email) values (new.id, new.email)
-  on conflict (id) do nothing;
-  return new;
-end;
-$$;
-
-drop trigger if exists on_auth_user_created on auth.users;
-create trigger on_auth_user_created
-  after insert on auth.users
-  for each row execute function public.handle_new_user();
-
--- ============================================================
--- projects — espelha pp_projects_v1
--- ============================================================
-create table if not exists public.projects (
-  id          uuid primary key default gen_random_uuid(),
-  user_id     uuid not null references auth.users(id) on delete cascade,
-  name        text not null,
-  created_at  timestamptz not null default now()
-);
-alter table public.projects enable row level security;
-create index if not exists projects_user_idx on public.projects(user_id);
-
-create policy "projects_all_own" on public.projects
-  for all using (user_id = auth.uid()) with check (user_id = auth.uid());
-
--- ============================================================
--- prompts — espelha pp_prompts_v1
--- ============================================================
-create table if not exists public.prompts (
-  id          uuid primary key default gen_random_uuid(),
-  user_id     uuid not null references auth.users(id) on delete cascade,
-  title       text not null,
-  content     text not null,
-  category    text,
-  tags        text[] not null default '{}',
-  favorite    boolean not null default false,
-  project_id  uuid references public.projects(id) on delete set null,
-  created_at  timestamptz not null default now(),
-  updated_at  timestamptz not null default now()
-);
-alter table public.prompts enable row level security;
-create index if not exists prompts_user_idx on public.prompts(user_id);
-
-create policy "prompts_all_own" on public.prompts
-  for all using (user_id = auth.uid()) with check (user_id = auth.uid());
-
-create trigger prompts_set_updated before update on public.prompts
-  for each row execute function public.set_updated_at();
-
--- ============================================================
--- products — catálogo de produtos Amazon (espelha amz_products_v1)
--- path: 'buybox' (disputar catálogo) | 'zero' (publicar do zero)
--- brand_status: nao_exigida | pendente | em_analise | liberada
--- ============================================================
-create table if not exists public.products (
-  id            uuid primary key default gen_random_uuid(),
-  user_id       uuid not null references auth.users(id) on delete cascade,
-  sku           text,
-  title         text not null,
-  brand         text,
-  ean           text,
-  category      text,
-  audience      text,
-  features      text[] not null default '{}',
-  keywords      text[] not null default '{}',
-  path          text not null default 'buybox' check (path in ('buybox','zero')),
-  asin          text,
-  brand_status  text not null default 'nao_exigida'
-                  check (brand_status in ('nao_exigida','pendente','em_analise','liberada')),
-  created_at    timestamptz not null default now(),
-  updated_at    timestamptz not null default now()
-);
-alter table public.products enable row level security;
-create index if not exists products_user_idx on public.products(user_id);
-
-create policy "products_all_own" on public.products
-  for all using (user_id = auth.uid()) with check (user_id = auth.uid());
-
-create trigger products_set_updated before update on public.products
-  for each row execute function public.set_updated_at();
-
--- ============================================================
--- amazon_accounts — METADADOS da conta de vendedor (NÃO-secreto)
--- Marketplace BR (Brasil) = A2Q3Y263D00KWC
--- ============================================================
-create table if not exists public.amazon_accounts (
-  id             uuid primary key default gen_random_uuid(),
-  user_id        uuid not null references auth.users(id) on delete cascade,
-  label          text not null default 'Conta principal',
-  seller_id      text,
-  marketplace_id text not null default 'A2Q3Y263D00KWC',
-  region         text not null default 'na',  -- SP-API endpoint region (na cobre BR)
-  created_at     timestamptz not null default now(),
-  updated_at     timestamptz not null default now()
-);
-alter table public.amazon_accounts enable row level security;
-create index if not exists amazon_accounts_user_idx on public.amazon_accounts(user_id);
-
-create policy "amazon_accounts_all_own" on public.amazon_accounts
-  for all using (user_id = auth.uid()) with check (user_id = auth.uid());
-
-create trigger amazon_accounts_set_updated before update on public.amazon_accounts
-  for each row execute function public.set_updated_at();
-
--- ============================================================
--- amazon_credentials — SEGREDOS (LWA refresh token, client id/secret)
--- RLS LIGADA e SEM policies => nenhum cliente (anon/authenticated) lê.
--- Apenas o service_role (Edge Functions) acessa, ignorando RLS.
--- ============================================================
-create table if not exists public.amazon_credentials (
-  account_id          uuid primary key references public.amazon_accounts(id) on delete cascade,
-  user_id             uuid not null references auth.users(id) on delete cascade,
-  lwa_client_id       text,
-  lwa_client_secret   text,   -- TODO: usar Vault/criptografia (ver SETUP-SUPABASE.md)
-  lwa_refresh_token   text,
-  updated_at          timestamptz not null default now()
-);
-alter table public.amazon_credentials enable row level security;
--- sem policies de propósito: bloqueia todo acesso de cliente.
-
-create trigger amazon_credentials_set_updated before update on public.amazon_credentials
-  for each row execute function public.set_updated_at();
-
--- ============================================================
--- publish_jobs — pipeline de publicação (assíncrono)
--- status: queued -> submitting -> submitted -> accepted | error
--- ============================================================
-create table if not exists public.publish_jobs (
-  id                 uuid primary key default gen_random_uuid(),
-  user_id            uuid not null references auth.users(id) on delete cascade,
-  product_id         uuid references public.products(id) on delete set null,
-  amazon_account_id  uuid references public.amazon_accounts(id) on delete set null,
-  type               text not null check (type in ('buybox','zero')),
-  status             text not null default 'queued'
-                       check (status in ('queued','submitting','submitted','accepted','error')),
-  sp_api_submission_id text,
-  request_payload    jsonb,
-  response           jsonb,
-  error              text,
-  created_at         timestamptz not null default now(),
-  updated_at         timestamptz not null default now()
-);
-alter table public.publish_jobs enable row level security;
-create index if not exists publish_jobs_user_idx on public.publish_jobs(user_id);
-create index if not exists publish_jobs_status_idx on public.publish_jobs(status);
-
--- cliente pode LER seus jobs e CRIAR (enfileirar). A Edge Function (service_role)
--- atualiza status/resposta. Update/insert de status fica com o backend.
-create policy "publish_jobs_select_own" on public.publish_jobs
-  for select using (user_id = auth.uid());
-create policy "publish_jobs_insert_own" on public.publish_jobs
-  for insert with check (user_id = auth.uid() and status = 'queued');
-
-create trigger publish_jobs_set_updated before update on public.publish_jobs
-  for each row execute function public.set_updated_at();

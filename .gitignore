.env
.env.*
!.env.example

# Tokens do TikTok gravados pelo worker (access/refresh de UMA conta, valem 365 dias).
# O .env.tiktok com client_key/secret ja cai no .env.* acima. Os dois comecam com ponto,
# entao o send_head do serve.py tambem se recusa a servi-los pela porta 8765.
video-worker/.tiktok-tokens.json

node_modules/
dist/
build/
.cache/
.vite/

# Bytecode do Python: gerado por import, muda a cada execução do trabalhador/testes e
# não é fonte. Estava staged em video-worker/__pycache__/ (ciclo 2, 12/08/2026).
__pycache__/
*.pyc

.DS_Store
Thumbs.db

*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

.supabase/
supabase/.branches/
supabase/.temp/

# Preferências locais do Claude Code (por-máquina, não versionar)
.claude/settings.local.json

# Renders do Remotion: saida gerada, nao fonte.
studio/out/
studio/public/clips/

